{
  "$schema": "vscode://schemas/color-theme",
  "name": "Masum Galaxy // Future Code",
  "type": "dark",
  "colors": {
    "editor.background": "#030510",
    "editor.foreground": "#D9F7FF",
    "editorCursor.foreground": "#00F7FF",
    "editor.lineHighlightBackground": "#0B153044",
    "editor.selectionBackground": "#183D6655",
    "editorLineNumber.foreground": "#3B5970",
    "editorLineNumber.activeForeground": "#55F6FF",
    "sideBar.background": "#050817",
    "sideBar.foreground": "#A8DDEB",
    "activityBar.background": "#02040D",
    "activityBar.foreground": "#00E7FF",
    "statusBar.background": "#050817",
    "statusBar.foreground": "#9DF8FF",
    "titleBar.activeBackground": "#030611",
    "titleBar.activeForeground": "#BFFAFF",
    "terminal.background": "#02040C",
    "terminal.foreground": "#B8F7FF",
    "terminalCursor.foreground": "#00F7FF",
    "focusBorder": "#00E7FF88"
  },
  "tokenColors": [
    {"scope":["keyword","storage.type","storage.modifier"],"settings":{"foreground":"#00F7FF","fontStyle":"bold"}},
    {"scope":["entity.name.function","support.function"],"settings":{"foreground":"#B56CFF"}},
    {"scope":["string","string.quoted"],"settings":{"foreground":"#64FFB4"}},
    {"scope":["constant.numeric","constant.language"],"settings":{"foreground":"#FFCC66"}},
    {"scope":["variable","meta.definition.variable.name"],"settings":{"foreground":"#D9F7FF"}},
    {"scope":["entity.name.type","entity.name.class","support.type"],"settings":{"foreground":"#FF63D8"}},
    {"scope":["comment"],"settings":{"foreground":"#526D80","fontStyle":"italic"}},
    {"scope":["invalid","invalid.illegal"],"settings":{"foreground":"#FF3B6B","fontStyle":"bold"}}
  ]
}
