{
  "name": "masum-galaxy-future-code",
  "displayName": "Masum Galaxy // Future Code",
  "description": "A futuristic robotic VS Code theme with an optional animated galaxy cockpit featuring 8 planets, Sun, Moon, nebulae, HUD effects and neon syntax.",
  "version": "3.0.0",
  "publisher": "gitwithmasum",
  "author": {
    "name": "Masum Billah",
    "url": "https://github.com/gitwithmasum"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes",
    "Visualization"
  ],
  "keywords": [
    "galaxy",
    "space",
    "futuristic",
    "robotic",
    "cyberpunk",
    "neon",
    "dark theme",
    "animated theme",
    "solar system",
    "planet",
    "sci-fi",
    "cockpit",
    "hud",
    "developer theme"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#020510",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitwithmasum/Galaxy-VS-Code-Themes.git"
  },
  "homepage": "https://github.com/gitwithmasum/Galaxy-VS-Code-Themes#readme",
  "bugs": {
    "url": "https://github.com/gitwithmasum/Galaxy-VS-Code-Themes/issues"
  },
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:masumGalaxy.installCockpit",
    "onCommand:masumGalaxy.removeCockpit",
    "onCommand:masumGalaxy.reloadCockpit"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Masum Galaxy // Future Code",
        "uiTheme": "vs-dark",
        "path": "./themes/masum-galaxy-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "masumGalaxy.installCockpit",
        "title": "Masum Galaxy: Install Animated Cockpit"
      },
      {
        "command": "masumGalaxy.removeCockpit",
        "title": "Masum Galaxy: Remove Animated Cockpit"
      },
      {
        "command": "masumGalaxy.reloadCockpit",
        "title": "Masum Galaxy: Reload Animated Cockpit"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
